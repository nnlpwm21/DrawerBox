<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19044.0</SupportedOSPlatformVersion>
    <!-- Copied files keep the DeskBoxWhite namespaces verbatim; only the
         assembly/executable is named DrawerBox. -->
    <RootNamespace>DeskBoxWhite</RootNamespace>
    <AssemblyName>DrawerBox</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <ApplicationIcon>Assets\drawer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\drawer.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskboxwhite-tray-light.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskboxwhite-tray-dark.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Strings\zh-CN.json" />
    <EmbeddedResource Include="Strings\zh-TW.json" />
    <EmbeddedResource Include="Strings\en-US.json" />
    <EmbeddedResource Include="Strings\ja-JP.json" />
    <EmbeddedResource Include="Strings\de-DE.json" />
    <EmbeddedResource Include="Strings\pt-BR.json" />
    <EmbeddedResource Include="Strings\hi-IN.json" />
    <EmbeddedResource Include="Strings\es-ES.json" />
    <EmbeddedResource Include="Strings\fr-FR.json" />
    <EmbeddedResource Include="Strings\ar-SA.json" />
    <EmbeddedResource Include="Strings\bn-BD.json" />
    <EmbeddedResource Include="Strings\ru-RU.json" />
  </ItemGroup>

</Project>
