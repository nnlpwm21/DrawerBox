<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBoxWhite.Views.DrawerSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:DeskBoxWhite.Views.SettingsSections">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Padding="24,20,24,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,16" VerticalScrollBarVisibility="Auto">
            <sections:ShortcutDrawerSettingsSection x:Name="Section" />
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="ExitButton"
                Style="{StaticResource ActionButtonStyle}"
                HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
