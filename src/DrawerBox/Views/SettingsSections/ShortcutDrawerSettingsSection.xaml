<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBoxWhite.Views.SettingsSections.ShortcutDrawerSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBoxWhite.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <StackPanel Margin="0,8,0,0" Spacing="4">

            <toolkit:SettingsCard
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Hotkey.FollowGlobal"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Hotkey.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="GlobalHotkeyButton"
                        Click="GlobalHotkeyButton_Click"
                        Style="{StaticResource ActionButtonStyle}" />
                    <ToggleSwitch x:Name="GlobalHotkeyToggle" Toggled="GlobalHotkeyToggle_Toggled" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Icons.Description"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Icons.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEB9F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="IconSizeText"
                               MinWidth="36"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                    <TextBox x:Name="IconSizeBox"
                             MinWidth="64"
                             TextChanged="IconSizeBox_TextChanged" />
                    <Slider x:Name="IconSizeSlider"
                            MinWidth="140"
                            MaxWidth="220"
                            ValueChanged="IconSizeSlider_ValueChanged" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Spacing.Description"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Spacing.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" svc:Localized.Key="Settings.ShortcutDrawer.Spacing.Rows" />
                    <TextBox x:Name="RowSpacingBox" MinWidth="56" TextChanged="RowSpacingBox_TextChanged" />
                    <TextBlock VerticalAlignment="Center" svc:Localized.Key="Settings.ShortcutDrawer.Spacing.Columns" />
                    <TextBox x:Name="ColumnSpacingBox" MinWidth="56" TextChanged="ColumnSpacingBox_TextChanged" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                x:Name="ShortcutDrawerDrawersExpander"
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Drawers.Description"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Drawers.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8CF;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="NewDrawerTextBox"
                        MinWidth="220"
                        HorizontalAlignment="Stretch"
                        KeyDown="NewDrawerTextBox_KeyDown" />
                    <Button
                        x:Name="AddDrawerButton"
                        MinWidth="0"
                        Padding="12,6"
                        Click="AddDrawerButton_Click"
                        HorizontalContentAlignment="Center">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                </StackPanel>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        svc:Localized.HeaderKey="Settings.ShortcutDrawer.Drawers.ListTitle">
                        <StackPanel x:Name="DrawersEditorPanel" Spacing="8" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Appearance.Description"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Appearance.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox
                    x:Name="AppearanceModeCombo"
                    MinWidth="0"
                    SelectionChanged="AppearanceModeCombo_SelectionChanged"
                    SelectedIndex="0">
                    <ComboBoxItem
                        svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Mode.Card" />
                    <ComboBoxItem
                        svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Mode.Color" />
                    <ComboBoxItem
                        svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Mode.Image" />
                </ComboBox>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        x:Name="AppearanceColorCard"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <!-- #AARRGGBB; alpha = how translucent, darker palettes read best. -->
                            <TextBox
                                x:Name="AppearanceColorBox"
                                PlaceholderText="#B31F1F1F"
                                TextChanged="AppearanceColorBox_TextChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="AppearanceColorSwatch"
                                    Click="AppearanceColorSwatch_Click"
                                    Width="150"
                                    Height="28"
                                    Background="#B31F1F1F"
                                    svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Swatch"
                                    CornerRadius="4" />
                            </StackPanel>
                            <TextBlock
                                TextWrapping="Wrap"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Color.Hint" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        x:Name="AppearanceImageCard"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Button
                                x:Name="AppearanceImageBrowse"
                                Click="AppearanceImageBrowse_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                svc:Localized.Key="Settings.ShortcutDrawer.Appearance.Browse" />
                            <TextBlock
                                x:Name="AppearanceImagePathText"
                                TextWrapping="Wrap"
                                Style="{StaticResource SettingDescriptionTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                x:Name="ShortcutDrawerPackExpander"
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.ShortcutDrawer.Pack.Description"
                svc:Localized.HeaderKey="Settings.ShortcutDrawer.Pack.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ExportPackButton"
                        Click="ExportPackButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        svc:Localized.Key="Settings.ShortcutDrawer.Pack.Export" />
                    <Button
                        x:Name="ImportPackButton"
                        Click="ImportPackButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        svc:Localized.Key="Settings.ShortcutDrawer.Pack.Import" />
                </StackPanel>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch">
                        <TextBlock
                            x:Name="PackStatusText"
                            TextWrapping="Wrap"
                            Style="{StaticResource SettingDescriptionTextStyle}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

        </StackPanel>
    </StackPanel>
</UserControl>